{
  "name": "alma-devin-cli",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "Alma integration for the native Devin CLI ACP server",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test",
    "install:alma": "node scripts/manage.mjs install",
    "uninstall:alma": "node scripts/manage.mjs uninstall",
    "doctor": "node scripts/manage.mjs doctor",
    "models": "node scripts/manage.mjs models",
    "smoke": "node scripts/manage.mjs smoke",
    "smoke:tools": "node scripts/tool-smoke.mjs",
    "smoke:bypass": "node scripts/smoke-tools.mjs",
    "check:host": "node scripts/check-host.mjs"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "2.6.0"
  }
}
